# Use a long, random value in production.
AUDIT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional API authentication. Requests must send: Authorization: Bearer <token>
RUNTIME_API_TOKEN=

# Optional OpenAI-compatible provider settings.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
